#!/bin/sh
# okf pre-commit: block a commit only when it adds OKF hard failures (a ratchet).
# Old failures never block you, and the count stored in .okf-baseline only goes down.
# Install from your knowledge-base repo root:
#   ln -s "$OKF_HOME/hooks/pre-commit" .git/hooks/pre-commit
# Skip once with: git commit --no-verify
# ponytail: checks the working tree, not only staged content. Use `git stash -k` first if that matters.
OKF="${OKF_HOME:-$HOME/code/okf}"
[ -f "$OKF/scripts/okf.py" ] || { echo "okf pre-commit: okf.py not found in $OKF. Set OKF_HOME to your okf clone."; exit 1; }
if out=$(uv run -q "$OKF/scripts/okf.py" check . --all --baseline .okf-baseline 2>&1); then
  printf '%s\n' "$out" | grep '^okf: baseline' && git add .okf-baseline
  exit 0
fi
printf '%s\n' "$out" | tail -1
fails=$(printf '%s\n' "$out" | grep -E '^  .*: (no-frontmatter|bad-frontmatter|no-type|index-frontmatter|log-heading|log-order)')
[ -n "$fails" ] || exit 1  # okf.py itself failed, and the line above says why
# Name the culprit: hard failures in changed files (staged, unstaged, untracked), else in any file.
# quotePath=false keeps spaces and accents unquoted, so names match check's output.
# ponytail: a path with a tab, newline, quote, or backslash stays quoted and unmatched. Parse -z output if that bites.
git="git -c core.quotePath=false"
where="changed files"
changed=$($git diff --cached --name-only; $git diff --name-only; $git ls-files --others --exclude-standard)
hits=$(printf '%s\n' "$fails" | while IFS= read -r line; do
  f=${line#  }
  f=${f%%: *}
  printf '%s\n' "$changed" | grep -qxF -- "$f" && echo "$line"
done)
if [ -z "$hits" ]; then
  where="the repo (none in changed files, so check okf.toml), first 20"
  hits=$(printf '%s\n' "$fails" | head -n 20)
fi
echo "Hard failures in $where:"
printf '%s\n' "$hits"
echo "Fix them, or skip this check once with: git commit --no-verify"
exit 1
